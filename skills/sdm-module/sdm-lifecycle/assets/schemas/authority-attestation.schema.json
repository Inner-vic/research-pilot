{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bmad.dev/sdm/authority-attestation.schema.json",
  "title": "SDM Ed25519 Authority Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "signature",
    "public_key_pem",
    "trust_snapshot",
    "trust_snapshot_digest"
  ],
  "properties": {
    "schema": {
      "const": "sdm-authority-attestation/v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "role",
        "principal_id",
        "key_digest",
        "issued_at",
        "expires_at",
        "nonce",
        "expected_revision",
        "governed_ids",
        "digests"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "key_digest": {
          "$ref": "#/$defs/digest"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "governed_ids": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+$"
    },
    "public_key_pem": {
      "type": "string",
      "pattern": "^-----BEGIN PUBLIC KEY-----\\n(?:[A-Za-z0-9+/=]+\\n)+-----END PUBLIC KEY-----\\n$"
    },
    "trust_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "verifier",
        "keys",
        "revocations"
      ],
      "properties": {
        "schema": {
          "const": "sdm-trust-snapshot/v1"
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^\\u0000]+$"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal_id",
              "key_digest",
              "public_key_pem",
              "roles"
            ],
            "properties": {
              "principal_id": {
                "type": "string"
              },
              "key_digest": {
                "$ref": "#/$defs/digest"
              },
              "public_key_pem": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "valid_from": {
                "$ref": "#/$defs/timestamp"
              },
              "valid_until": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "revocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key_digest",
              "effective_at"
            ],
            "properties": {
              "key_digest": {
                "$ref": "#/$defs/digest"
              },
              "effective_at": {
                "$ref": "#/$defs/timestamp"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "trust_snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "consumed_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
      },
      "additionalProperties": true
    }
  }
}
