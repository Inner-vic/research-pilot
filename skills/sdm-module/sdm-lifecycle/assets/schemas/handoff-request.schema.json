{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bmad.dev/sdm/handoff-request.schema.json",
  "title": "SDM Platform Handoff Request (S12)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "operation", "domain", "binding_key", "binding_identity", "binding_skill_digest", "adapter_contract_digest", "workspace_id", "workspace_revision", "gate", "step", "subjects", "expected_evidence", "evidence_cardinality", "portable_paths", "idempotency_key", "created_at", "expected_result_schema", "retry_of"],
  "properties": {
    "schema": {"const": "sdm-handoff-request/v1"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "operation": {"type": "string", "pattern": "^(?:data|git|jenkins|ml)\\.[a-z][a-z0-9-]*$"},
    "domain": {"enum": ["data-platform", "source-control-platform", "ci-platform", "ml-execution-platform"]},
    "binding_key": {"type": "string", "minLength": 1},
    "binding_identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "binding_skill_digest": {"$ref": "#/$defs/digest"},
    "adapter_contract_digest": {"$ref": "#/$defs/digest"},
    "workspace_id": {"type": "string", "minLength": 1},
    "workspace_revision": {"type": "integer", "minimum": 0},
    "gate": {"type": "string", "minLength": 1},
    "step": {"type": "integer", "minimum": 1, "maximum": 21},
    "subjects": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_cardinality": {"type": "object", "additionalProperties": {"type": "object"}},
    "portable_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "idempotency_key": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "expected_result_schema": {"const": "schemas/handoff-result.schema.json"},
    "retry_of": {"type": ["string", "null"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
