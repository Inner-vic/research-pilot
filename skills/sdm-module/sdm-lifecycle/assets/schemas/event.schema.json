{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bmad.dev/sdm/event.schema.json",
  "title": "SDM Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "event_type", "occurred_at", "actor", "subjects", "payload", "operation_id", "engine_contract_digest", "previous_hash", "event_hash"],
  "properties": {
    "schema": {"const": "sdm-event/v1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "occurred_at": {"$ref": "#/$defs/timestamp"},
    "actor": {"type": "object", "required": ["type", "id"], "properties": {"type": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "subjects": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "payload": {"type": "object", "properties": {"coordinator_disposition": {"enum": ["dispatched", "invoke_error", "dispatch_unknown"]}}},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "engine_contract_digest": {"$ref": "#/$defs/digest"},
    "previous_hash": {"$ref": "#/$defs/digest"},
    "authority": {"type": "array", "items": {"type": "object"}},
    "event_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"}
  }
}
