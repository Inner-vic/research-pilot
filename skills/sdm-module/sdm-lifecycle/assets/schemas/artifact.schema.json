{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bmad.dev/sdm/artifact.schema.json",
  "title": "SDM Governed Artifact Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_type", "artifact_id", "instance_key", "version", "status", "subjects", "content", "content_digest", "created_at", "created_by"],
  "properties": {
    "schema": {"const": "sdm-artifact/v1"},
    "artifact_type": {"type": "string", "pattern": "^(?:[GBERDMT][0-9]{2}|S(?:0[1-9]|1[0-9]))$"},
    "artifact_id": {"type": "string", "minLength": 1},
    "instance_key": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "status": {"enum": ["draft", "published", "frozen", "terminal", "superseded", "deprecated", "retired", "cancelled", "archived"]},
    "subjects": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "content": {"type": "object"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "uri": {"type": "string", "minLength": 1},
    "source_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}, "uniqueItems": true},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "created_by": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["uri", "digest"],
      "properties": {"uri": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "signature": {"type": "string", "minLength": 1}}
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"}, "additionalProperties": true}
  }
}
