{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bmad.dev/sdm/result.schema.json",
  "title": "SDM Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "command", "revision", "result", "findings"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "conflict", "configuration_required", "internal_error"]},
    "command": {"type": "string", "minLength": 1},
    "revision": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "result": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"}, "additionalProperties": true}
  }
}
